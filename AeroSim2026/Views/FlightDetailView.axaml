<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"                          
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rxui="http://reactiveui.net"
             xmlns:mapsui="using:Mapsui.UI.Avalonia"
             xmlns:vm="using:AeroSim2026.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="AeroSim2026.Views.FlightDetailView"
             x:DataType="vm:FlightDetailViewModel"
             
             x:TypeArguments="vm:FlightDetailViewModel">
    <Design.DataContext>
        <vm:FlightDetailViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto, *" Margin="20">
    
    <Grid Grid.Row="0" Margin="0,0,0,20">
        
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <Button Command="{Binding GoBackCommand}" Content="← Back" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Button Content="Export to FMS" 
                Command="{Binding ExportFmsCommand}" 
                Classes="accent" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"/>
        
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*, 2*, *" RowDefinitions="Auto, *" ShowGridLines="False" Height="800">
        
        <Border Grid.Column="0" Grid.Row="0" CornerRadius="10,0,0,0" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="ORIGIN" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.StartAirport.Ident}" 
                           FontSize="36" FontWeight="Bold" 
                           Foreground="#FF8C00" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.StartAirport.AirportName}" 
                           TextWrapping="Wrap" TextAlignment="Center"/>
                
                <Separator Background="#444" Margin="0,10"/>
                
                <TextBlock Text="{Binding Flight.StartAirport.AirportsLocation.DisplayLocation}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <Separator Background="#444" Margin="0,10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="0" Grid.Row="1" CornerRadius="0,0,0,10" Padding="15">
            <StackPanel Spacing="10">
    <TextBlock Text="RUNWAYS" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
    
    <Grid ColumnDefinitions="*, *" Margin="12,0,12,5">
        <TextBlock Grid.Column="0" Text="IDENT" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
        <TextBlock Grid.Column="1" Text="LENGTH" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
    </Grid>

    <ListBox ItemsSource="{Binding Flight.StartAirport.Runways}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*, *">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayIdent}" Foreground="#4FACFE" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat='{}{0} ft'}" Foreground="#A0A0A0"/>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Padding="20" BorderBrush="#3E3E42" BorderThickness="1,0">
            <StackPanel Spacing="20">
                
                <Border x:Name="MapContainer" Height="400" CornerRadius="5" ClipToBounds="True" BorderBrush="#444" BorderThickness="1" Background="#111">
                    <mapsui:MapControl Map="{Binding FlightMap}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
                </Border>

                <StackPanel Spacing="10">
                    <StackPanel.Styles>
                        <Style Selector="StackPanel.DataCell">
                            <Setter Property="MinWidth" Value="150"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                        <Style Selector="StackPanel.DataCell > :is(Control)">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                        <Style Selector="TextBlock.DataHeader">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="Gray"/>
                        </Style>
                        <Style Selector="TextBlock.DataValue">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </StackPanel.Styles>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Classes="DataCell">
                            <TextBlock Text="AIRCRAFT" Classes="DataHeader"/>
                            <TextBlock Text="{Binding Flight.AircraftModel.DisplayName}" Classes="DataValue"/>
                        </StackPanel>

                        <StackPanel Classes="DataCell">
                            <TextBlock Text="DISTANCE" Classes="DataHeader"/>
                            <TextBlock Text="{Binding Flight.DistanceNm, StringFormat='{}{0} nm'}" Classes="DataValue"/>
                        </StackPanel>
                        
                        <StackPanel Classes="DataCell">
                            <TextBlock Text="EST. FLIGHT TIME" Classes="DataHeader"/>
                            <TextBlock Text="{Binding Flight.DisplayEstTime}" Classes="DataValue"/>
                        </StackPanel>
                        
                        <StackPanel Classes="DataCell">
                            <TextBlock Text="DATE FLOWN" Classes="DataHeader"/>
                            <TextBlock Text="{Binding EditDateFlown, StringFormat='{}{0:MM/dd/yyyy}'}" Classes="DataValue" IsVisible="{Binding !IsEditing}"/>
                                <CalendarDatePicker SelectedDate="{Binding EditDateFlown}" IsVisible="{Binding IsEditing}" Watermark="Select Date"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel Classes="DataCell">
                            <TextBlock Text="CRASHED?" Classes="DataHeader"/>
                            <TextBlock Text="{Binding CrashedDisplayText}" 
                                       Classes="DataValue"
                                       IsVisible="{Binding !IsEditing}"/>
                            <CheckBox IsChecked="{Binding IsCrashed}" 
                                      IsVisible="{Binding IsEditing}"
                                      Content="Yes"/>
                        </StackPanel> 

                        <StackPanel Classes="DataCell">
                            <TextBlock Text="CRUISE ALTITUDE" Classes="DataHeader"/>
                            <TextBlock Text="{Binding EditCruiseAltitude, StringFormat='{}{0} ft.'}" Classes="DataValue" IsVisible="{Binding !IsEditing}"/>
                                <NumericUpDown Value="{Binding EditCruiseAltitude}" Minimum="0" Maximum="60000" Increment="500" FormatString="0" IsVisible="{Binding IsEditing}"/>
                        </StackPanel> 

                        <StackPanel Classes="DataCell">
                            <TextBlock Text="DATE CREATED" Classes="DataHeader"/>
                            <TextBlock Text="{Binding Flight.DateCreated, StringFormat='{}{0:MM/dd/yyyy}'}" Classes="DataValue"/>
                        </StackPanel>
                        <StackPanel Classes="DataCell">
                            <Button Command="{Binding BeginEditCommand}" IsVisible="{Binding !IsEditing}" Background="Transparent" FontWeight="Bold">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="Edit" FontSize="20"/>
                                    <TextBlock Text="Edit" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" Background="Transparent" FontWeight="Bold">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="Save" FontSize="20"/>
                                    <TextBlock Text="Save" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsEditing}" Background="Transparent" FontWeight="Bold">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:FluentIcon Icon="DismissCircle" FontSize="20" />
                                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TabControl Margin="0,10,0,0" Padding="0,10,0,0">
                    
                    <TabItem Header="ROUTE WAYPOINTS" FontSize="12" FontWeight="Bold">
                        <StackPanel Margin="0,10,0,0">
                            <Grid ColumnDefinitions="45, 100, *, 65" Margin="12,0,12,5">
            <TextBlock Grid.Column="0" Text="SEQ" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="IDENT" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="TYPE" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="ALT" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold" HorizontalAlignment="Left"/>
        
                            </Grid>

                            <ListBox ItemsSource="{Binding FlightRoutes}" 
                                     Background="Transparent" 
                                     BorderThickness="0"
                                     MaxHeight="250"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#334FACFE" />
                                    </Style>
    
                                    <Style Selector="ListBoxItem:nth-child(odd) /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
    
                                    <Style Selector="ListBoxItem:nth-child(even) /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" CornerRadius="5" Margin="0,2">
                                            <Grid ColumnDefinitions="45, 100, *, 65">
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding SequenceNumber}" 
                                                           FontWeight="Bold" 
                                                           FontSize="12" 
                                                           VerticalAlignment="Center" 
                                                           Foreground="Gray"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Waypoint.Ident}" 
                                                           FontWeight="Bold" 
                                                           FontSize="14" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" 
                                                           VerticalAlignment="Center"/>
                                                
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding Waypoint.WaypointType}" 
                                                           TextWrapping="Wrap" 
                                                           FontSize="12" 
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="3" Text="{Binding PlannedAltitude, StringFormat='{}{0}'}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="FLIGHT NOTES" FontSize="12" FontWeight="Bold">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding EditComments}" IsVisible="{Binding !IsEditing}" Height="80" TextWrapping="Wrap" Foreground="#CCCCCC"/>
                            <TextBox Text="{Binding EditComments}" IsVisible="{Binding IsEditing}" Height="80" TextWrapping="Wrap" Watermark="Enter flight notes here..."/>
                        </StackPanel>
                    </TabItem>

                </TabControl>
                
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" CornerRadius="0,10,10,0" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="DESTINATION" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.EndAirport.Ident}" 
                           FontSize="36" FontWeight="Bold" 
                           Foreground="#00F260" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.EndAirport.AirportName}" 
                           TextWrapping="Wrap" TextAlignment="Center"/>

                <Separator Background="#444" Margin="0,10"/>

                <TextBlock Text="{Binding Flight.EndAirport.AirportsLocation.DisplayLocation}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

        </Border>
        <Border Grid.Column="2" Grid.Row="0" CornerRadius="0,10,0,0" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="DESTINATION" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.EndAirport.Ident}" 
                           FontSize="36" FontWeight="Bold" 
                           Foreground="#FF0000" HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding Flight.EndAirport.AirportName}" 
                           TextWrapping="Wrap" TextAlignment="Center"/>

                <Separator Background="#444" Margin="0,10"/>

                <TextBlock Text="{Binding Flight.EndAirport.AirportsLocation.DisplayLocation}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                <Separator Background="#444" Margin="0,10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" CornerRadius="0,0,10,0" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="ARRIVAL RUNWAYS" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                
                <Grid ColumnDefinitions="*, *" Margin="12,0,12,5">
                    <TextBlock Grid.Column="0" Text="IDENT" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="LENGTH" FontSize="10" Foreground="#A0A0A0" FontWeight="Bold"/>
                </Grid>

                <ListBox ItemsSource="{Binding Flight.EndAirport.Runways}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, *">
                                <TextBlock Grid.Column="0" Text="{Binding DisplayIdent}" Foreground="#00F260" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat='{}{0} ft'}" Foreground="#A0A0A0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</rxui:ReactiveUserControl>
